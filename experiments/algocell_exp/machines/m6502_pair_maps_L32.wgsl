        if (f == 19u) { m6502_x = t; }                                        // SBX: X = (A & X) - imm
        return;
    }
    if (f == 13u) {                                                           // BIT: N V from v, Z from A & v
        m6502_p = (m6502_p & 0x3du) | (v & 0xc0u) | select(0u, 0x02u, (m6502_a & v) == 0u);
        return;
