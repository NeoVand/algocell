        }
        case 7u: {                                                           // BPL BMI BVC BVS BCC BCS BNE BEQ
            let k = op >> 6u;                                                // 0 N, 1 V, 2 C, 3 Z
            let sh = select(select(select(7u, 6u, k == 1u), 0u, k == 2u), 1u, k == 3u);
            if (((m6502_p >> sh) & 1u) == ((op >> 5u) & 1u)) {
                m6502_pc = (m6502_pc + b1 + select(0u, 0xff00u, b1 >= 0x80u)) & 0xffffu;
            }
        }
        case 8u: { m6502_push(select(m6502_a, m6502_p | 0x30u, op == 0x08u)); }     // PHA, PHP (B and bit 5 set)
        case 9u: {                                                           // PLA, PLP (B clear, bit 5 set)
            let v = m6502_pull();
            if (op == 0x28u) { m6502_p = (v & 0xcfu) | 0x20u; } else { m6502_a = v; m6502_nz(v); }
        }
        case 10u: {                                                          // CLC SEC CLI SEI CLV CLD SED
            let k = op >> 6u;                                                // 0 C, 1 I, 2 V, 3 D
            let bit = select(select(select(0x01u, 0x04u, k == 1u), 0x40u, k == 2u), 0x08u, k == 3u);
            m6502_p = select(m6502_p & ~bit, m6502_p | bit, (op & 0x20u) != 0u && k != 2u);
        }
        case 11u: {                                                          // TXA TYA TAX TAY TSX TXS INX DEX INY DEY
            let step = (d >> 8u) & 3u;
            let dst = (d >> 26u) & 3u;
            let r = (m6502_reg((d >> 24u) & 3u) + select(select(0u, 1u, step == 1u), 0xffu, step == 2u)) & 0xffu;
            m6502_a = select(m6502_a, r, dst == 0u);
            m6502_x = select(m6502_x, r, dst == 1u);
            m6502_y = select(m6502_y, r, dst == 2u);
            m6502_s = select(m6502_s, r, dst == 3u);
            if (dst != 3u) { m6502_nz(r); }                                  // TXS sets no flags
        }
        default: {                                                           // JAM
            m6502_halted = ZIL_HALT_TRAP; m6502_trap = ZIL_TRAP_ILLEGAL; m6502_pc = pc0;
        }
    }
}

fn m6502_step() {
    if (m6502_halted != 0u) { return; }
    let pc0 = m6502_pc;
    let op = m6502_fetch();
    let act = on_instruction_start(pc0, op);
    if (act == ZIL_HALT) { m6502_halted = ZIL_HALT_HOST; m6502_pc = pc0; return; }
    if (act == ZIL_SKIP) { return; }
    if (on_decode(0u, op)) { return; }   // ablated: a 1-byte no-op; operand bytes run as code
    let d = M6502_DECODE[op];
    let am = d & 0xfu;            // 0 none, 1 imm/rel, 2 zp, 3 zp,X, 4 zp,Y, 5 abs, 6 abs,X, 7 abs,Y, 8 (zp,X), 9 (zp),Y
    let cls = (d >> 20u) & 0xfu;
    // Operand bytes. JSR pushes its return address (PC on its high operand byte) before fetching that byte.
    var b1 = 0u;
    var b2 = 0u;
    if (am != 0u) { b1 = m6502_fetch(); }
    if (cls == 2u) { m6502_push(m6502_pc >> 8u); m6502_push(m6502_pc & 0xffu); }
    if (am >= 5u && am <= 7u) { b2 = m6502_fetch(); }
    // Effective address. Zero-page modes wrap at 8 bits, the others at 16; pointers are read in page 0.
    var base = (b2 << 8u) | b1;
    if (am >= 8u) { base = m6502_zp16((b1 + select(0u, m6502_x, am == 8u)) & 0xffu); }
    let idx = select(select(0u, m6502_x, am == 3u || am == 6u), m6502_y, am == 4u || am == 7u || am == 9u);
    let ea = (base + idx) & select(0xffffu, 0xffu, am >= 2u && am <= 4u);
    // Read; read-modify-write writes the old value back, then the new one.
    var v = b1;
    if ((d & 0x10u) != 0u) { v = mem_read(ea); }
    let sop = (d >> 8u) & 7u;
    if ((d & 0x20u) != 0u) {
        mem_write(ea, v);
        v = m6502_shift(sop, v);
        mem_write(ea, v);
    }
    if ((d & 0x40u) != 0u) { m6502_a = m6502_shift(sop, m6502_a); }
    let alu = (d >> 11u) & 0x1fu;
    if (alu != 0u) { m6502_alu(alu, v); }
    if ((d & 0x80u) != 0u) { m6502_store((d >> 16u) & 7u, base, idx, ea); }
    if (cls != 0u) { m6502_control(cls, op, d, base, b1, pc0); }
}

// === World (L1): lane lifecycle ===
fn zil_reset() {   // the world reset: every state field at its reset value
    m6502_a = 0x0u;
    m6502_x = 0x0u;
    m6502_y = 0x0u;
    m6502_s = 0x0u;
    m6502_p = 0x20u;
    m6502_pc = 0x0u;
    m6502_halted = 0x0u;
    m6502_trap = 0x0u;
}
fn zil_init_state() {   // init conventions (stack, entry, set, random)
    m6502_s = 0xffu; // first push lands at position 63 of 64
    m6502_a = 0x0u; // init.set
    m6502_x = 0x0u; // init.set
    m6502_y = 0x0u; // init.set
    m6502_p = 0x20u; // init.set
}
fn zil_halt_reason() -> u32 { return m6502_halted; }
fn zil_trap_cause() -> u32 { return select(0u, m6502_trap, m6502_halted == ZIL_HALT_TRAP); }   // 0, or the trap cause that halted the lane
fn zil_pc() -> u32 { return m6502_pc; }
fn zil_reset_lane(lane: u32, seed: u32) {   // a fresh lane: privates, counters, maps, state, init conventions
    zil_lane = lane;
    zil_seed = seed;
    zil_step = 0u;
    zil_step_hi = 0u;
    zil_step_base = vec2<u32>(0u, 0u);
    zil_steps_total = 0u;
    zil_steps_prev = 0u;
    for (var i = 0u; i < 2u; i++) { zil_writes[i] = 0u; }
    for (var i = 0u; i < 2u; i++) { zil_fetch_map[i] = 0u; }
    for (var i = 0u; i < 2u; i++) { zil_start_map[i] = 0u; }
    zil_reset();
    zil_init_state();
}
fn zil_set_step_base(step_base: vec2<u32>) {   // the dial index of the next step (zil_run continues from it)
    zil_step_base = step_base;
    zil_step = step_base.x;
    zil_step_hi = step_base.y;
}
fn zil_begin_at(lane: u32, seed: u32, step_base: vec2<u32>) {   // zil_reset_lane, the step base, then on_reset (last word on the state)
    zil_reset_lane(lane, seed);
    zil_set_step_base(step_base);
    on_reset();
}
fn zil_begin(lane: u32, seed: u32) {   // zil_begin_at with step base 0
    zil_begin_at(lane, seed, vec2<u32>(0u, 0u));
}
// Runs up to `budget` more steps and returns the steps executed. It may be called again on
// the same lane: the step index the dials see (zil_step, zil_step_hi) is the step base plus the steps run since zil_begin.
fn zil_run(budget: u32) -> u32 {
    var steps = 0u;
    loop {
        if (steps >= budget) { break; }
        if (zil_halt_reason() != ZIL_RUNNING) { break; }
        zil_step = zil_step_base.x + zil_steps_total;
        zil_step_hi = zil_step_base.y + select(0u, 1u, zil_step < zil_step_base.x);
        m6502_step();
        steps = steps + 1u;
        zil_steps_total = zil_steps_total + 1u;
    }
    return steps;
}
fn zil_load_memory(base: u32) {   // zil_mem[base ..] (word-padded segments) -> lane memory
    for (var b = 0u; b < 32u; b++) { zil_m[0u + b] = (zil_mem[base + 0u + (b >> 2u)] >> ((b & 3u) * 8u)) & 0xffu; } // A
    for (var b = 0u; b < 32u; b++) { zil_m[32u + b] = (zil_mem[base + 8u + (b >> 2u)] >> ((b & 3u) * 8u)) & 0xffu; } // B
}
fn zil_store_memory(base: u32) {   // lane memory -> zil_mem[base ..]; padding is never stored in memory
    for (var w = 0u; w < 8u; w++) { // A
        var v = 0u;
        for (var k = 0u; k < 4u; k++) {
            let b = w * 4u + k;
            if (b < 32u) { v = v | (zil_m[0u + b] << (k * 8u)); }
        }
        zil_mem[base + 0u + w] = v;
    }
    for (var w = 0u; w < 8u; w++) { // B
        var v = 0u;
        for (var k = 0u; k < 4u; k++) {
            let b = w * 4u + k;
            if (b < 32u) { v = v | (zil_m[32u + b] << (k * 8u)); }
        }
        zil_mem[base + 8u + w] = v;
    }
}
fn zil_store_state(o: u32) {
    zil_out[o + 0u] = m6502_a & 0xffu; // a
    zil_out[o + 1u] = m6502_x & 0xffu; // x
    zil_out[o + 2u] = m6502_y & 0xffu; // y
    zil_out[o + 3u] = m6502_s & 0xffu; // s
    zil_out[o + 4u] = m6502_p & 0xffu; // p
    zil_out[o + 5u] = m6502_pc & 0xffffu; // pc
    zil_out[o + 6u] = m6502_halted & 0xffu; // halted
    zil_out[o + 7u] = m6502_trap & 0xffu; // trap
}
fn zil_store_record(o: u32, steps: u32) {   // the lane record (manifest.record); steps: run since zil_begin / zil_resume
    zil_out[o] = zil_steps_prev + steps;
    zil_out[o + 1u] = zil_halt_reason();
    zil_out[o + 2u] = zil_trap_cause();
    zil_store_state(o + 3u);
    for (var i = 0u; i < 2u; i++) { zil_out[o + 11u + i] = zil_writes[i]; }
    for (var i = 0u; i < 2u; i++) { zil_out[o + 13u + i] = zil_fetch_map[i]; }
    for (var i = 0u; i < 2u; i++) { zil_out[o + 15u + i] = zil_start_map[i]; }
}
// Continue a lane from its record at zil_out[o ..] (load its memory with zil_load_memory first). The raw on_reset hook
// does not run again: the lane is not starting, it is resuming. Raw-hook private state does not carry over.
fn zil_resume(lane: u32, seed: u32, step_base: vec2<u32>, o: u32) {
    zil_reset_lane(lane, seed);
    zil_set_step_base(step_base);
    zil_steps_prev = zil_out[o];
    m6502_a = zil_out[o + 3u] & 0xffu; // a
    m6502_x = zil_out[o + 4u] & 0xffu; // x
    m6502_y = zil_out[o + 5u] & 0xffu; // y
    m6502_s = zil_out[o + 6u] & 0xffu; // s
    m6502_p = zil_out[o + 7u] & 0xffu; // p
    m6502_pc = zil_out[o + 8u] & 0xffffu; // pc
    m6502_halted = zil_out[o + 9u] & 0xffu; // halted
    m6502_trap = zil_out[o + 10u] & 0xffu; // trap
    for (var i = 0u; i < 2u; i++) { zil_writes[i] = zil_out[o + 11u + i]; }
    for (var i = 0u; i < 2u; i++) { zil_fetch_map[i] = zil_out[o + 13u + i]; }
    for (var i = 0u; i < 2u; i++) { zil_start_map[i] = zil_out[o + 15u + i]; }
}

@compute @workgroup_size(64)
fn main(@builtin(global_invocation_id) zil_gid: vec3u) {
    let i = zil_gid.x;
    if (i >= zil_params.lane_count) { return; }
    zil_load_memory(i * ZIL_MEM_WORDS);
    if (zil_params.resume != 0u) {
        zil_resume(zil_params.lane_base + i, zil_params.seed, zil_params.step_base, i * ZIL_RECORD_WORDS);
    } else {
        zil_begin_at(zil_params.lane_base + i, zil_params.seed, zil_params.step_base);
    }
    let steps = zil_run(zil_budget_in[i]);
    zil_store_memory(i * ZIL_MEM_WORDS);
    zil_store_record(i * ZIL_RECORD_WORDS, steps);
}
